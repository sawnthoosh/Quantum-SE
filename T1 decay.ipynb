import numpy as np
import matplotlib.pyplot as plt
from qutip import *

T1 = 3.0

decay_rate = 1 / T1
c_ops = [np.sqrt(decay_rate) * destroy(2)]

psi0 = basis(2, 1)

H = 0.5 * sigmaz()


tlist = np.linspace(0, 5, 300)

# Solve with decoherence - QuTiP 5 syntax
result = mesolve(H, psi0, tlist, c_ops)

# Probability of still being in |1> over time
prob_excited = expect(ket2dm(basis(2, 1)), result.states)

plt.figure(figsize=(10, 5))
plt.plot(tlist, prob_excited, color='crimson', linewidth=2.5)
plt.xlabel('Time', fontsize=13)
plt.ylabel('Probability of |1⟩', fontsize=13)
plt.title('T1 Decay — Qubit dying from |1⟩ back to |0⟩', fontsize=15)
plt.axhline(y=0.37, color='gray', linestyle='--', alpha=0.7, label='T1 point (37%)')
plt.axvline(x=T1, color='orange', linestyle='--', alpha=0.7, label=f'T1 = {T1}s')
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()

print("At T1, qubit has 37% chance of still being in |1>")
print("After 5xT1, qubit is basically dead — back to |0>")
