import numpy as np
import matplotlib.pyplot as plt

# Simulate IQ readout data
# When qubit is in |0> - IQ point lands in one place
# When qubit is in |1> - IQ point lands in another place

np.random.seed(42)
n_shots = 500 

# |0> state cluster - centered at (-1, 0)
I_zero = np.random.normal(-1, 0.3, n_shots)
Q_zero = np.random.normal(0, 0.3, n_shots)

# |1> state cluster - centered at (1, 0)
I_one = np.random.normal(1, 0.3, n_shots)
Q_one = np.random.normal(1, 0.3, n_shots)

# Plotting graph
plt.figure(figsize=(8, 8))
plt.scatter(I_zero, Q_zero, color='royalblue', alpha=0.5, label='|0⟩ state', s=20)
plt.scatter(I_one, Q_one, color='crimson', alpha=0.5, label='|1⟩ state', s=20)
plt.axvline(x=0, color='black', linestyle='--', alpha=0.5, label='Decision boundary')
plt.xlabel('I (In-phase)', fontsize=13)
plt.ylabel('Q (Quadrature)', fontsize=13)
plt.title('IQ Plane — Qubit Readout', fontsize=15)
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()

print("Blue dots = qubit measured as |0>")
print("Red dots  = qubit measured as |1>")
print("Black line = decision boundary — left of line = |0>, right = |1>")
